# Copy to edit/.htaccess; create the password file with: htpasswd -c edit/.htpasswd <user>
AuthType Basic
AuthName "Edit"
AuthUserFile /absolute/path/to/edit/.htpasswd
Require valid-user

# probe.php lets the page ask "am I signed in?" without showing a login prompt to visitors.
<Files "probe.php">
  Header always unset WWW-Authenticate
</Files>
