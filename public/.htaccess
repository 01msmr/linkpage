# Hide the seed folder.
RedirectMatch 404 ^/seeds(/|$)

# /folder/link/?open shows the list with that entry opened (real files and folders such as /edit/ are left alone).
RewriteEngine On
RewriteCond %{QUERY_STRING} (^|&)open(&|=|$)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^[^.]+/?$ index.html [L]

# /slug, /slug/ and /slug/index.html all open go.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)/?$ go.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/.]+)/index\.html$ go.html [L]

# Caching: html always revalidated, css/js one hour.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=3600"
  </FilesMatch>
</IfModule>

# PWA manifest type.
AddType application/manifest+json .webmanifest
